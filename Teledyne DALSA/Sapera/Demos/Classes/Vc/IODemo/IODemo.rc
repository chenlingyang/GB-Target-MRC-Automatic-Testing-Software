    CONTROL         132,IDC_STATIC,"Static",SS_BITMAP | SS_CENTERIMAGE,0,0,44,342,WS_EX_ACCEPTFILES | WS_EX_STATICEDGE
END

IDD_SCG_ABOUTBOX DIALOGEX 0, 0, 217, 55
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
