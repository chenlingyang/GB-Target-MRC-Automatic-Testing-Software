FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,32,46,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,99,46,50,14
    COMBOBOX        IDC_SCG_COMBO_SERVER,7,23,172,38,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Select Acquisition Device:",IDC_SCG_SELECT_SERVER_LABEL,7,8,108,8
END

IDD_SCG_GIO DIALOGEX 0, 0, 523, 350
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "General I/O module"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
