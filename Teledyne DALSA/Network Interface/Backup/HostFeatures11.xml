   <!-- #################### TurboDrive #################### -->

   <Boolean Name="turboTransferEnable" MergePriority="+1">
      <ToolTip>TurboDrive activation</ToolTip>
      <Description>Sets the enable state of the TurboDrive mode, if available. TurboDrive allows GigE Vision cameras to send lossless pixel information at a rate in excess of 125 MB/s, increasing line and frame rates beyond the nominal link capacity. TurboDrive performance depends on image content, but is often double the standard throughput.</Description>
      <DisplayName>Turbo Transfer Mode</DisplayName>
      <pIsLocked>turboTransferModeLocked_reg</pIsLocked>
      <Streamable>Yes</Streamable>
      <pValue>turboTransferEnable_impl</pValue>
   </Boolean>
  
   <Integer Name="turboTransferEnable_impl">
      <pIndex>transferTurboCurrentlyAbailable</pIndex>
      <pValueIndexed Index="0">turboTransferEnabl_off</pValueIndexed>
      <pValueDefault>turboTransferMode_reg</pValueDefault>
   </Integer>
  
   <Integer Name="turboTransferEnabl_off">
      <ImposedAccessMode>RO</ImposedAccessMode>
      <Value>0</Value>
   </Integer>
  
   <IntReg Name="turboTransferModeLocked_reg">
      <Address>0xEB000500</Address>
      <Length>4</Length>
      <AccessMode>RO</AccessMode>
      <pPort>SaperaPort</pPort>
      <Sign>Unsigned</Sign>
      <Endianess>LittleEndian</Endianess>
   </IntReg>

   <IntReg Name="turboTransferMode_reg">
      <Address>0xEB000504</Address>
      <Length>4</Length>
      <AccessMode>RW</AccessMode>
      <pPort>SaperaPort</pPort>
      <Cachable>NoCache</Cachable>
      <Sign>Unsigned</Sign>
      <Endianess>LittleEndian</Endianess>
   </IntReg>

   <Integer Name="turboTransferQualityLevel_Val">
      <pValue>turboTransferQualityLevel_Converter</pValue>
      <pValueCopy>turboTransferQualityLevel_1_Converter</pValueCopy>
      <pValueCopy>turboTransferQualityLevel_2_Converter</pValueCopy>
   </Integer>

   <IntConverter Name="turboTransferQualityLevel_Converter">
      <pVariable Name="LEVEL1">turboTransferQualityLevel_1</pVariable>
      <pVariable Name="LEVEL2">turboTransferQualityLevel_2</pVariable>
      <pVariable Name="ODDLEVEL">transferTurbo2OddLossyLevel_isAvailable</pVariable>
      <FormulaTo>  ODDLEVEL? ((LEVEL1 &lt;&lt; 4) | LEVEL2): ((LEVEL1=0)? 0x00: (((LEVEL1-1) &lt;&lt; 4) | (LEVEL1+1)))</FormulaTo>
      <FormulaFrom>ODDLEVEL? ((LEVEL1 &lt;&lt; 4) | LEVEL2): ((LEVEL1=0)? 0x00: (((LEVEL1-1) &lt;&lt; 4) | (LEVEL1+1)))</FormulaFrom>
      <pValue>turboTransferQualityLevel_Select</pValue>
      <Representation>Linear</Representation>
      <Slope>Varying</Slope>
   </IntConverter>

   <Integer Name="turboTransferQualityLevel_Select">
      <DisplayName>Turbo Quality Level Select</DisplayName>
      <Value>0x00</Value>
      <Min>0x00</Min>
      <Max>0xFF</Max>
      <Representation>HexNumber</Representation>
   </Integer>

   <IntConverter Name="turboTransferQualityLevel_1_Converter">
      <pVariable Name="LEVEL2">turboTransferQualityLevel_2_Converter</pVariable>
      <pVariable Name="ODDLEVEL">transferTurbo2OddLossyLevel_isAvailable</pVariable>
      <FormulaTo>   ODDLEVEL? ((FROM &amp; 0xF0) &gt;&gt; 4): (((FROM &amp; 0xF0) &gt;&gt; 4) + (FROM &amp; 0x0F))/2</FormulaTo>
      <FormulaFrom> ODDLEVEL? ((TO &lt;&lt; 4) | LEVEL2): ((TO=0)? 0x00: (((TO-1) &lt;&lt; 4) | (TO+1))))</FormulaFrom>
      <pValue>turboTransferQualityLevel_1</pValue>
      <Representation>Linear</Representation>
      <Slope>Varying</Slope>
   </IntConverter>

   <IntConverter Name="turboTransferQualityLevel_2_Converter">
      <pVariable Name="LEVEL1">turboTransferQualityLevel_1</pVariable>
      <pVariable Name="ODDLEVEL">transferTurbo2OddLossyLevel_isAvailable</pVariable>
      <FormulaTo>   ODDLEVEL? (FROM &amp; 0x0F): 0xFF</FormulaTo>
      <FormulaFrom> ODDLEVEL? ((LEVEL1 &lt;&lt; 4) | TO): 0xFF</FormulaFrom>
      <pValue>turboTransferQualityLevel_2</pValue>
      <Representation>Linear</Representation>
      <Slope>Varying</Slope>
   </IntConverter>

